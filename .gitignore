# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# claude code - permissões e config local da ferramenta, não é código do projeto.
# Exceção: a skill de design do front-end fica versionada de propósito,
# pra sobreviver a um clone novo do repo e documentar o processo. Git não
# deixa reincluir um arquivo cujo diretório pai esteja ignorado - por isso
# cada nível abaixo de .claude/ precisa da própria negação em vez de só
# negar o arquivo final.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/frontend-design/

# starter baixado do TiDB Cloud pra pegar a string de conexão - não é
# parte do projeto, tem seu próprio repositório git
/tidb-nodejs-prisma-quickstart/
