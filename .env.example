DATABASE_URL="mysql://root:root@localhost:3306/reclame_cidade"
AUTH_SECRET=""
GEMINI_API_KEY=""

# Necessária para upload de imagem nas reclamações. Crie um Blob store
# em vercel.com (dashboard > Storage > Create > Blob) e copie o token
# gerado — funciona em desenvolvimento local, não precisa estar
# publicado na Vercel.
BLOB_READ_WRITE_TOKEN=""

# Opcional: usada para montar o link no e-mail de verificação de conta.
# Default: http://localhost:3000
NEXT_PUBLIC_APP_URL=""

# Opcionais: envio real do e-mail de verificação via Resend.
# Crie uma chave grátis em resend.com > API Keys. Sem RESEND_API_KEY, o
# link só aparece no log do servidor (ver src/lib/email.ts) - útil pra
# dev sem precisar de conta em provedor nenhum.
# RESEND_FROM_EMAIL precisa ser um remetente de um domínio verificado no
# Resend; sem domínio próprio, "onboarding@resend.dev" funciona pra teste
# mas só entrega pro e-mail cadastrado na sua conta Resend.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Opcionais: proteção antifake no cadastro (Cloudflare Turnstile).
# Crie uma chave grátis em dash.cloudflare.com > Turnstile > Add site.
# Sem essas variáveis, o cadastro funciona normalmente sem verificação
# de bot (ver src/lib/turnstile.ts).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Obrigatória para o resumo semanal por e-mail (assinatura de cidade/
# categoria). Protege /api/cron/resumo-semanal contra chamadas de fora -
# só quem manda "Authorization: Bearer <este valor>" consegue disparar o
# envio. Gere um valor aleatório (ex.: `openssl rand -hex 32`) e configure
# o mesmo valor na env var CRON_SECRET do projeto na Vercel, que já manda
# esse header automaticamente pros crons definidos em vercel.json.
CRON_SECRET=""